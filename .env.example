# Copy to .env and fill in values for your environment.
# All services are reached by hostname — adjust if running outside Docker or on a different network.

# PostgreSQL (QL backend)
POSTGRES_HOST=postgres
POSTGRES_DB_NAME=quality_link
POSTGRES_USER=quality_link
POSTGRES_PASSWORD=

# MinIO (bronze tier)
MINIO_HOST=minio:9000
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_BUCKET_NAME=quality-link

# Jena Fuseki (silver tier)
FUSEKI_URL=http://fuseki:3030
FUSEKI_DATASET_NAME=quality_link
FUSEKI_USERNAME=
FUSEKI_PASSWORD=

# Meilisearch (gold tier)
MEILISEARCH_URL=http://meilisearch:7700
MEILISEARCH_API_KEY=
MEILISEARCH_INDEX=courses
